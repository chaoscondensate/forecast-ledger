{
  "$defs": {
    "question-patch": {
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "notes": {
          "anyOf": [
            {
              "minLength": 0,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "open",
            "closed",
            "awaiting_resolution"
          ]
        },
        "tags": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/slug"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "slug": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "type": "string"
    }
  },
  "$id": "https://chaoscondensate.com/schemas/forecast-ledger-cli/input/question-patch/v2",
  "$ref": "#/$defs/question-patch",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
