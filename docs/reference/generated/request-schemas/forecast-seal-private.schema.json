{
  "$defs": {
    "binSetRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "version": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "type": "object"
    },
    "binnedPmfEntry": {
      "additionalProperties": false,
      "properties": {
        "bin_id": {
          "$ref": "#/$defs/slug"
        },
        "probability": {
          "$ref": "#/$defs/probability"
        }
      },
      "required": [
        "bin_id",
        "probability"
      ],
      "type": "object"
    },
    "binnedPmfRepresentation": {
      "additionalProperties": false,
      "properties": {
        "bin_set_ref": {
          "$ref": "#/$defs/binSetRef"
        },
        "entries": {
          "items": {
            "$ref": "#/$defs/binnedPmfEntry"
          },
          "minItems": 1,
          "type": "array"
        },
        "kind": {
          "const": "binned_pmf"
        },
        "left_tail_probability": {
          "$ref": "#/$defs/probability"
        },
        "right_tail_probability": {
          "$ref": "#/$defs/probability"
        }
      },
      "required": [
        "kind",
        "bin_set_ref",
        "entries",
        "left_tail_probability",
        "right_tail_probability"
      ],
      "type": "object"
    },
    "cdfPoint": {
      "additionalProperties": false,
      "properties": {
        "probability": {
          "$ref": "#/$defs/probability"
        },
        "value": {
          "$ref": "#/$defs/scalarValue"
        }
      },
      "required": [
        "value",
        "probability"
      ],
      "type": "object"
    },
    "cdfRepresentation": {
      "additionalProperties": false,
      "properties": {
        "interpolation": {
          "enum": [
            "step_right",
            "linear"
          ]
        },
        "kind": {
          "const": "cdf"
        },
        "left_tail_probability": {
          "$ref": "#/$defs/probability"
        },
        "points": {
          "items": {
            "$ref": "#/$defs/cdfPoint"
          },
          "minItems": 1,
          "type": "array"
        },
        "right_tail_probability": {
          "$ref": "#/$defs/probability"
        }
      },
      "required": [
        "kind",
        "interpolation",
        "points",
        "left_tail_probability",
        "right_tail_probability"
      ],
      "type": "object"
    },
    "credibleInterval": {
      "additionalProperties": false,
      "properties": {
        "coverage": {
          "$ref": "#/$defs/openProbability"
        },
        "interval_kind": {
          "enum": [
            "equal_tailed",
            "central",
            "highest_density",
            "author_selected"
          ]
        },
        "lower": {
          "$ref": "#/$defs/scalarValue"
        },
        "upper": {
          "$ref": "#/$defs/scalarValue"
        }
      },
      "required": [
        "coverage",
        "interval_kind",
        "lower",
        "upper"
      ],
      "type": "object"
    },
    "credibleIntervalsRepresentation": {
      "additionalProperties": false,
      "properties": {
        "intervals": {
          "items": {
            "$ref": "#/$defs/credibleInterval"
          },
          "minItems": 1,
          "type": "array"
        },
        "kind": {
          "const": "credible_intervals"
        }
      },
      "required": [
        "kind",
        "intervals"
      ],
      "type": "object"
    },
    "forecast-seal-private": {
      "additionalProperties": false,
      "properties": {
        "comment": {
          "minLength": 0,
          "type": "string"
        },
        "key_factors": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "rationale": {
          "minLength": 0,
          "type": "string"
        },
        "representations": {
          "items": {
            "$ref": "#/$defs/forecastRepresentation"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "representations",
        "rationale",
        "key_factors",
        "comment"
      ],
      "type": "object"
    },
    "forecastRepresentation": {
      "oneOf": [
        {
          "$ref": "#/$defs/probabilityRepresentation"
        },
        {
          "$ref": "#/$defs/pmfRepresentation"
        },
        {
          "$ref": "#/$defs/binnedPmfRepresentation"
        },
        {
          "$ref": "#/$defs/quantilesRepresentation"
        },
        {
          "$ref": "#/$defs/cdfRepresentation"
        },
        {
          "$ref": "#/$defs/pointRepresentation"
        },
        {
          "$ref": "#/$defs/credibleIntervalsRepresentation"
        }
      ]
    },
    "openProbability": {
      "description": "An exact canonical decimal probability strictly between 0 and 1.",
      "pattern": "^0\\.[0-9]{0,17}[1-9]$",
      "type": "string"
    },
    "optionSetRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "version": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "type": "object"
    },
    "pmfEntry": {
      "additionalProperties": false,
      "properties": {
        "option_id": {
          "$ref": "#/$defs/slug"
        },
        "probability": {
          "$ref": "#/$defs/probability"
        }
      },
      "required": [
        "option_id",
        "probability"
      ],
      "type": "object"
    },
    "pmfRepresentation": {
      "additionalProperties": false,
      "properties": {
        "entries": {
          "items": {
            "$ref": "#/$defs/pmfEntry"
          },
          "minItems": 2,
          "type": "array"
        },
        "kind": {
          "const": "pmf"
        },
        "option_set_ref": {
          "$ref": "#/$defs/optionSetRef"
        }
      },
      "required": [
        "kind",
        "option_set_ref",
        "entries"
      ],
      "type": "object"
    },
    "pointRepresentation": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "point"
        },
        "statistic": {
          "enum": [
            "mean",
            "median",
            "mode",
            "best_estimate"
          ]
        },
        "value": {
          "$ref": "#/$defs/scalarValue"
        }
      },
      "required": [
        "kind",
        "statistic",
        "value"
      ],
      "type": "object"
    },
    "probability": {
      "description": "An exact canonical decimal probability in [0,1], with at most 18 fractional digits.",
      "pattern": "^(?:0|1|0\\.[0-9]{0,17}[1-9])$",
      "type": "string"
    },
    "probabilityRepresentation": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "probability"
        },
        "outcome": {
          "const": true
        },
        "probability": {
          "$ref": "#/$defs/probability"
        }
      },
      "required": [
        "kind",
        "outcome",
        "probability"
      ],
      "type": "object"
    },
    "quantilePoint": {
      "additionalProperties": false,
      "properties": {
        "level": {
          "$ref": "#/$defs/openProbability"
        },
        "value": {
          "$ref": "#/$defs/scalarValue"
        }
      },
      "required": [
        "level",
        "value"
      ],
      "type": "object"
    },
    "quantilesRepresentation": {
      "additionalProperties": false,
      "properties": {
        "interpolation": {
          "enum": [
            "none",
            "linear",
            "step_lower",
            "step_upper"
          ]
        },
        "kind": {
          "const": "quantiles"
        },
        "points": {
          "items": {
            "$ref": "#/$defs/quantilePoint"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "kind",
        "interpolation",
        "points"
      ],
      "type": "object"
    },
    "scalarValue": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "minLength": 1,
          "type": "string"
        }
      ]
    },
    "slug": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "type": "string"
    }
  },
  "$id": "https://chaoscondensate.com/schemas/forecast-ledger-cli/input/forecast-seal-private/v2",
  "$ref": "#/$defs/forecast-seal-private",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
