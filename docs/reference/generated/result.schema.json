  "$id": "https://chaoscondensate.com/schemas/forecast-ledger-cli/result/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "code": {
      "type": "string"
    },
    "data": {
      "description": "Operation-specific public data; timestamp.verify uses $defs.timestampVerificationData.",
      "type": "object"
    },
    "effects": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "enum": [
              "read",
              "create",
              "replace",
              "remove",
              "contact"
            ]
          },
          "kind": {
            "enum": [
              "ledger",
              "target",
              "evidence_index",
              "timestamp_request",
              "timestamp_response",
              "timestamp_trust",
              "key",
              "package",
              "network"
            ]
          },
          "owned": {
            "type": "boolean"
          },
          "path": {
            "type": "string"
          },
          "rollback": {
            "enum": [
              "none",
              "created_public",
              "retain_secret"
            ]
          },
          "root": {
            "type": "string"
          },
          "source_id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "planned",
              "deferred",
              "completed",
              "unchanged"
            ]
          }
        },
        "required": [
          "kind",
          "action",
          "status"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "message": {
      "type": "string"
    },
    "operation": {
      "type": "string"
    },
    "recovery": {
      "additionalProperties": false,
      "properties": {
        "actions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "message": {
          "type": "string"
        },
        "paths": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "state": {
          "enum": [
            "none",
            "complete",
            "pending",
            "retained",
            "required"
          ]
        }
      },
      "required": [
        "state"
      ],
      "type": "object"
    },
    "warnings": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "details": {
            "type": "object"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
